#!/bin/bash

### This script is called after the user upgrades the application.

NODE_BIN="/var/apps/nodejs_v24/target/bin"
DSH_HOME="${TRIM_PKGHOME}"
APP_HOME="${TRIM_APPDEST_VOL}/@appshare/fn-deepseek-harness"
NPM_CONFIG_PREFIX="${DSH_HOME}/.npm-global"
NPM_BIN="${NODE_BIN}/npm"
NPM_USER_CONFIG_FILE="${APP_HOME}/.npmrc"
LEGACY_NPM_REGISTRY_FILE="${APP_HOME}/.fn-deepseek-harness/npm-registry"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_CALLBACK="${SCRIPT_DIR}/install_callback"

export DSH_HOME
export HOME="${APP_HOME}"
export NPM_CONFIG_CACHE="${DSH_HOME}/.npm-cache"
export NPM_CONFIG_PREFIX
export NPM_CONFIG_USERCONFIG="${NPM_USER_CONFIG_FILE}"
export PATH="${NODE_BIN}:${NPM_CONFIG_PREFIX}/bin:${PATH}"

PACKAGE_MANAGER="npm"
PACKAGE_MANAGER_BIN="${NPM_BIN}"

log_message() {
    local level="$1"
    shift
    printf '[%s] [upgrade_callback] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*"
}

log_info() {
    log_message INFO "$@"
}

log_error() {
    log_message ERROR "$@" >&2
}

log_info "Starting DeepSeek Harness upgrade callback."

# FNOS-055：向导字段存在（含空值）时以提交值为准，空值即 npm 官方源；字段缺失
# （老版本升级/无向导）才回落到设备上已持久化的源。保留「字段是否存在」这一区别，
# 供安装回调按同一规则解析，避免这里先把空值替换成本地源。
WIZARD_REGISTRY_SET=0
if [ "${wizard_npm_registry+x}" = x ]; then
    WIZARD_REGISTRY_SET=1
    NPM_REGISTRY="${wizard_npm_registry:-https://registry.npmjs.org/}"
else
    if [ -f "${NPM_USER_CONFIG_FILE}" ]; then
        NPM_REGISTRY="$(NPM_CONFIG_USERCONFIG="${NPM_USER_CONFIG_FILE}" "${NPM_BIN}" config get registry --location=user 2>/dev/null || true)"
    else
        NPM_REGISTRY="$(tr -d '[:space:]' <"${LEGACY_NPM_REGISTRY_FILE}" 2>/dev/null || true)"
    fi
    NPM_REGISTRY="${NPM_REGISTRY:-https://registry.npmjs.org/}"
fi
log_info "Using npm registry ${NPM_REGISTRY}."

[ -f "${INSTALL_CALLBACK}" ] || {
    log_error "Install callback is unavailable; refusing a partial upgrade."
    exit 1
}
log_info "Running install callback to reconcile the fixed DSH runtime and published plugins."
if [ "${WIZARD_REGISTRY_SET}" = 1 ]; then
    wizard_npm_registry="${wizard_npm_registry}" \
        bash "${INSTALL_CALLBACK}" || {
        log_error "Install callback failed during upgrade."
        exit 1
    }
else
    # 明确移除，避免父进程导出的空值/旧值被安装回调当成「向导字段存在」。
    unset wizard_npm_registry
    bash "${INSTALL_CALLBACK}" || {
        log_error "Install callback failed during upgrade."
        exit 1
    }
fi

log_info "DeepSeek Harness upgrade callback completed."
exit 0
