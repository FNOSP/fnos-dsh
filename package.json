{
  "name": "fn-os-apps",
  "type": "module",
  "version": "5.6.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "飞牛 fnOS 应用 Monorepo",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "start": "pnpm exec fnos-dsh-cli start",
    "build": "pnpm exec fnos-dsh-cli build",
    "version": "pnpm exec fnos-dsh-cli version",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "docs:preview": "vitepress preview docs",
    "test": "turbo run test",
    "check": "pnpm exec fnos-dsh-cli check",
    "publish": "pnpm exec fnos-dsh-cli publish",
    "release:notes": "pnpm exec fnos-dsh-cli release:notes",
    "prepare": "lefthook install",
    "dev:web": "pnpm exec dsh web --no-open --port 8070"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@deepseek-ai/dsh": "catalog:",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:dsh",
    "@eslint-react/eslint-plugin": "catalog:",
    "@miletorix/vitepress-image-viewer": "catalog:",
    "@tnnevol/fnos-dsh-cli": "workspace:*",
    "@types/node": "catalog:",
    "@wasm-fmt/shfmt": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:"
  }
}
