{
  "name": "@tnnevol/dsh-zcode",
  "displayName": "ZCode",
  "type": "module",
  "version": "0.2.1-rc.2.36",
  "description": "ZCode Start Plan account login (OAuth) with a live entitlement-driven model catalog and per-model quota for DeepSeek Harness.",
  "author": "tnnevol",
  "license": "Apache-2.0",
  "homepage": "https://fndsh-doc.tnnevol.cn/plugins/dsh-zcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNOSP/fnos-dsh.git",
    "directory": "plugins/dsh-zcode-plugin"
  },
  "documentation": "https://fndsh-doc.tnnevol.cn/plugins/dsh-zcode",
  "bugs": {
    "url": "https://github.com/FNOSP/fnos-dsh/issues"
  },
  "keywords": [
    "zcode",
    "z-ai",
    "glm",
    "start-plan",
    "provider",
    "oauth",
    "account",
    "usage",
    "models"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "icon.png",
  "files": [
    "README.md",
    "compatibility.json",
    "cordis.patch.yml",
    "icon.png",
    "lib",
    "locale"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run check",
    "publish:next": "pnpm publish --tag next --access public",
    "test": "vitest run --config vitest.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-atomic-write": "catalog:dsh",
    "@deepseek-ai/dsh-attachment": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-model-selection": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-session": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:dsh",
    "@earendil-works/pi-ai": "catalog:",
    "@tnnevol/dsh-plugin-kit": "workspace:*",
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
