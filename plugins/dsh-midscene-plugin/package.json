{
  "name": "@tnnevol/dsh-midscene",
  "displayName": "Midscene Bridge",
  "type": "module",
  "version": "0.2.1-rc.2.20",
  "description": "Hosts a loopback OpenAI-compatible bridge that exposes every model configured in DSH (official routes, plugin routes, and user-declared providers) so Midscene browser automation can drive pages with natural language without holding any credential itself.",
  "author": "tnnevol",
  "license": "Apache-2.0",
  "homepage": "https://fnapps-doc.tnnevol.cn/plugins/dsh-midscene.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNOSP/fnos-dsh.git",
    "directory": "plugins/dsh-midscene-plugin"
  },
  "documentation": "https://fnapps-doc.tnnevol.cn/plugins/dsh-midscene",
  "bugs": {
    "url": "https://github.com/FNOSP/fnos-dsh/issues"
  },
  "keywords": [
    "midscene",
    "browser-automation",
    "e2e",
    "ui-testing",
    "bridge",
    "openai-compatible"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./compatibility.json": "./compatibility.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*",
    "./locale/*.json": "./locale/*.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "icon.png",
  "files": [
    "README.md",
    "compatibility.json",
    "cordis.patch.yml",
    "icon.png",
    "lib",
    "locale",
    "skills"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run check",
    "publish:next": "pnpm publish --tag next --access public",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "midscene-test --config tests/e2e/midscene.config.ts",
    "test:bridge": "node --experimental-strip-types scripts/bridge-smoke.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-skill": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "@midscene/test": "catalog:",
    "@midscene/web": "catalog:",
    "@tnnevol/dsh-e2e-kit": "workspace:*",
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
