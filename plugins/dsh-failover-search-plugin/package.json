{
  "name": "@tnnevol/dsh-failover-search",
  "displayName": "Failover Search",
  "type": "module",
  "version": "6.1.4",
  "description": "Composite DSH web-search provider that fails over TinyFish → Tavily → official DeepSeek, spreads requests across multiple accounts per platform, and shows platform usage on the plugin page.",
  "author": "tnnevol",
  "license": "Apache-2.0",
  "homepage": "https://fnapps-doc.tnnevol.cn/plugins/dsh-failover-search.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FNOSP/fnos-dsh.git",
    "directory": "plugins/dsh-failover-search-plugin"
  },
  "documentation": "https://fnapps-doc.tnnevol.cn/plugins/dsh-failover-search",
  "bugs": {
    "url": "https://github.com/FNOSP/fnos-dsh/issues"
  },
  "keywords": [
    "web-search",
    "search",
    "failover",
    "tinyfish",
    "tavily",
    "fetch",
    "fallback"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "icon.png",
  "files": [
    "README.md",
    "compatibility.json",
    "cordis.patch.yml",
    "icon.png",
    "lib",
    "locale"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run check",
    "publish:next": "pnpm publish --tag next --access public",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "midscene-test --config tests/e2e/midscene.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-credentials": "catalog:dsh",
    "@deepseek-ai/dsh-launch-environment": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-web": "catalog:dsh",
    "@deepseek-ai/dsh-web-fetch-http": "catalog:dsh",
    "@deepseek-ai/dsh-web-search-deepseek": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-credentials": "catalog:dsh",
    "@deepseek-ai/dsh-launch-environment": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-web": "catalog:dsh",
    "@deepseek-ai/dsh-web-fetch-http": "catalog:dsh",
    "@deepseek-ai/dsh-web-search-deepseek": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "@midscene/test": "catalog:",
    "@midscene/web": "catalog:",
    "@tnnevol/dsh-e2e-kit": "workspace:*",
    "@tnnevol/dsh-semi-ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
