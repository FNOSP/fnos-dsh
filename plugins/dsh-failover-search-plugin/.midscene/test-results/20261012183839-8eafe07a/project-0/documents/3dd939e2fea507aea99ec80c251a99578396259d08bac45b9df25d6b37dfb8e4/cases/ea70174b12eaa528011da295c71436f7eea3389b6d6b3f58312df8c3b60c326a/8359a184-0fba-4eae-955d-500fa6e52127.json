        "script": "(() => {\n  const b = document.querySelector('.dsh-failover-pill');\n  const pressed = b.getAttribute('aria-pressed');\n  if (pressed !== 'true') throw new Error('未能把按钮置为开启态，当前 aria-pressed=' + pressed);\n  // 组件源码：className 上带 --active 才是「激活态」的样式表达\n  // （styles.scss 里 .dsh-failover-pill--active 才有高亮背景）。\n  if (!b.classList.contains('dsh-failover-pill--active')) throw new Error('开启态却缺少 --active 类');\n  return { pressed: pressed, activeClass: true };\n})()\n"
      },
